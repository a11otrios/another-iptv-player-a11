{
  "name": "another-iptv-player-webos",
  "private": true,
  "version": "1.7.6",
  "description": "Another IPTV Player client for LG webOS TVs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package-webos.mjs",
    "deploy": "ares-install com.devyorg.anotheriptvplayer_1.7.6_all.ipk",
    "tv:smoke": "node scripts/tv-smoke.mjs",
    "i18n": "node scripts/convert-strings.mjs"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^2.3.0",
    "idb": "^8.0.0",
    "js-sha256": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-legacy": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webos-tools/cli": "^3.2.5",
    "fake-indexeddb": "^6.0.0",
    "hls.js": "^1.5.0",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
